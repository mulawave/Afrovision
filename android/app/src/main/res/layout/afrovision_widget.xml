<?xml version="1.0" encoding="utf-8"?>
<!--
  AfroVision Dashboard Widget — 4x2 home-screen widget.
  Rules:
    • NO @drawable/ references — inline colours only (launcher process can't
      reliably inflate custom GradientDrawable / LayerDrawable).
    • NO decimal layout_weight — integer weights only.
    • Only RemoteViews-safe view types: LinearLayout, TextView, ImageView, View.
    • No letterSpacing, no paddingStart/End, no custom fonts.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF050A30"
    android:padding="12dp">

    <!-- ── Row 1: Logo · App name · Notification badge · Live count ──── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="AFROVISION"
            android:textColor="#FFFFD700"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- Notification count — hidden when 0 -->
        <TextView
            android:id="@+id/widget_notif_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:background="#FFE53935"
            android:textColor="#FFFFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:text="0"
            android:visibility="gone" />

        <!-- Live channel count -->
        <TextView
            android:id="@+id/widget_live_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CCF49617"
            android:textColor="#FFFFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:text="0 LIVE" />

    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="#22FFD700" />

    <!-- ── Row 2: Upcoming show ─────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UP NEXT"
            android:textColor="#88FFD700"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="No upcoming shows" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_next_show"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#BBFFFFFF"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textColor="#FFF49617"
                android:textSize="9sp"
                android:textStyle="bold"
                android:text="" />

        </LinearLayout>

    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="#22FFD700" />

    <!-- ── Row 3: Plan · Renewal days · Waves · Library ────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#22FFD700"
            android:textColor="#FFFFD700"
            android:textSize="8sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:maxLines="1"
            android:text="Free Plan" />

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:textColor="#88FFFFFF"
            android:textSize="8sp"
            android:maxLines="1"
            android:text="" />

        <!-- Waves count — hidden when 0 -->
        <LinearLayout
            android:id="@+id/widget_waves_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~"
                android:textColor="#88FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_waves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textColor="#BBFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:text="0" />

        </LinearLayout>

        <!-- Library updates badge — hidden when 0 -->
        <TextView
            android:id="@+id/widget_library"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="#FFE53935"
            android:textColor="#FFFFFFFF"
            android:textSize="7sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:text="+0 New"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
