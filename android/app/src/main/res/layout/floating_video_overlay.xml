<?xml version="1.0" encoding="utf-8"?>
<!-- System overlay floating video window (shown above all apps). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- Video surface / WebView fills the entire window -->
    <WebView
        android:id="@+id/overlay_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top control bar with buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#AA000000">

        <!-- Return to app button -->
        <ImageButton
            android:id="@+id/overlay_return_to_app"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_plan_pill"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <!-- Channel surfer button -->
        <ImageButton
            android:id="@+id/overlay_channel_surfer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_card_bg"
            android:src="@android:drawable/ic_menu_search"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Close button -->
        <ImageButton
            android:id="@+id/overlay_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_badge_notif"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="fitCenter"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Channel name bar -->
    <TextView
        android:id="@+id/overlay_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="AfroVision" />

</FrameLayout>
