#!/usr/bin/env bash
set -euo pipefail

# Secondary guard to catch forbidden-service edits at push time.

upstream_ref=""
if upstream_ref="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)"; then
  range="$upstream_ref..HEAD"
else
  empty_tree="$(git hash-object -t tree /dev/null)"
  range="$empty_tree..HEAD"
fi

changed_files="$(git diff --name-only --diff-filter=ACMR "$range")"
if [ -z "$changed_files" ]; then
  exit 0
fi

forbidden_matches=()
while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    website/*|admin/*|backend/*)
      forbidden_matches+=("$file")
      ;;
  esac
done <<< "$changed_files"

if [ ${#forbidden_matches[@]} -gt 0 ]; then
  echo ""
  echo "PUSH BLOCKED: Forbidden service changes detected in commits being pushed."
  echo "This workstream permits mobile-only implementation changes."
  echo ""
  echo "Blocked files:"
  for file in "${forbidden_matches[@]}"; do
    echo "  - $file"
  done
  echo ""
  echo "Document required website/admin/backend changes in challenge-website-mobile-discrepancies.md and request explicit user approval."
  echo ""
  exit 1
fi

exit 0
