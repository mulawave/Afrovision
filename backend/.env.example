# ─── AfroVision Backend — Environment Variables ───────────────────────────────
# Copy this file to .env for local development.
# On Cloud Run, set these as environment variables (not a file).
# Secrets (JWT_SECRET, WALLET_SECRET) are auto-generated in Firestore on first boot
# and do NOT need to be set as env vars.

# ── Firebase ──────────────────────────────────────────────────────────────────
# Your Firebase project ID (found in Firebase console → Project Settings)
FIREBASE_PROJECT_ID=raven-ai-6ff76

# On Cloud Run, Application Default Credentials are provided automatically.
# For local development, point to a downloaded service account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave unset (or set to *) during development.
# Set to your Flutter app domain / CDN in production.
# ALLOWED_ORIGINS=https://app.afrovision.tv,https://www.afrovision.tv

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT automatically — do not set this on Cloud Run.
# PORT=3000

# ── Blockchain (optional — only needed for VPT token features) ────────────────
# VPT_TOKEN_ADDRESS=0x...
# DEPLOYER_PRIVATE_KEY=0x...
